{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "env": { "NODEJS_HELPERS": "0" },
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "excludeFiles": "{server/data/**,tests/**,docs/**,.agents/**,node_modules/@embedded-postgres/**,node_modules/embedded-postgres/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__eventease_path=:path*" }
  ]
}

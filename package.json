{
  "name": "crescent-events",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-static.js",
    "build:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/tailwind.css --watch",
    "serve": "python -m http.server 8000",
    "test": "node --test tests/*.test.js",
    "dev": "node --env-file-if-exists=.env.local server/index.js",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.js",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed.js",
    "db:import": "node --env-file-if-exists=.env.local scripts/import-sqlite.js",
    "test:api": "node --test tests/api.test.js",
    "test:postgres": "node scripts/test-postgres.js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "tailwindcss": "^4.1.0"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "pg": "^8.23.1",
    "qrcode-generator": "^2.0.4"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
